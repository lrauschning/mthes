@article{fleischmann95,
author = {Robert D. Fleischmann  and Mark D. Adams  and Owen White  and Rebecca A. Clayton  and Ewen F. Kirkness  and Anthony R. Kerlavage  and Carol J. Bult  and Jean-Francois Tomb  and Brian A. Dougherty  and Joseph M. Merrick  and Keith McKenney  and Granger Sutton  and Will FitzHugh  and Chris Fields  and Jeannine D. Gocayne  and John Scott  and Robert Shirley  and Li-lng Liu  and Anna Glodek  and Jenny M. Kelley  and Janice F. Weidman  and Cheryl A. Phillips  and Tracy Spriggs  and Eva Hedblom  and Matthew D. Cotton  and Teresa R. Utterback  and Michael C. Hanna  and David T. Nguyen  and Deborah M. Saudek  and Rhonda C. Brandon  and Leah D. Fine  and Janice L. Fritchman  and Joyce L. Fuhrmann  and N. S. M. Geoghagen  and Cheryl L. Gnehm  and Lisa A. McDonald  and Keith V. Small  and Claire M. Fraser  and Hamilton O. Smith  and J. Craig Venter },
